# Leave empty for web dev (uses Vite's /api proxy to http://localhost:5000)
# For the Capacitor Android APK, set this to your deployed backend URL, e.g.:
# VITE_API_URL=https://your-backend.onrender.com
VITE_API_URL=

# Domain used to build the QR/menu links shown in the vendor dashboard.
# Leave empty to fall back to window.location.origin (e.g. for local testing).
# VITE_FRONTEND_URL=https://your-frontend.netlify.app
VITE_FRONTEND_URL=
